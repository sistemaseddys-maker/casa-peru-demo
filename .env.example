# ── Demo Casa Perú ──────────────────────────────────────────
# Activa el lector de huella simulado (no requiere hardware)
DEMO_MODE=1
DEMO_COMPANY=Casa Perú

# Clave interna (el navegador usa X-Demo; esta clave es solo para agentes reales)
AGENT_API_KEY=demo-casa-peru-2026

# Base de datos PostgreSQL gratuita (Neon / Render / Supabase)
# Si no se define, usa SQLite local (attendance.db)
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# Para SQLite local puedes cambiar la ruta:
# DB_PATH=attendance.db
